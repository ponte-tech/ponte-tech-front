# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Anthropic Claude API (para extração automática de valores de documentos)
# Obtenha sua API key em: https://console.anthropic.com/
NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-...

# Nota: A funcionalidade de extração automática de valores só funcionará
# se a NEXT_PUBLIC_ANTHROPIC_API_KEY estiver configurada.
# Caso contrário, o upload de arquivos funcionará normalmente, mas sem extração automática.
